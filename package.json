{
  "name": "pi-claude-pro",
  "version": "1.1.0",
  "description": "Use your Claude Pro or Max subscription in Pi.",
  "type": "module",
  "license": "MIT",
  "author": "HugoLopes45 (https://github.com/HugoLopes45)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HugoLopes45/pi-claude-pro.git"
  },
  "homepage": "https://github.com/HugoLopes45/pi-claude-pro#readme",
  "bugs": {
    "url": "https://github.com/HugoLopes45/pi-claude-pro/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "claude",
    "claude-pro",
    "claude-max",
    "anthropic"
  ],
  "files": [
    "extensions",
    "src",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && vitest --run",
    "test": "vitest --run",
    "check:live": "node scripts/live-check.ts",
    "release": "node scripts/release.ts prepare",
    "prepublishOnly": "test -n \"$GITHUB_ACTIONS\" || test \"$(npm whoami)\" = hugolopes45 || { echo 'Publish only as the npm user hugolopes45.' >&2; exit 1; }; npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.3",
    "@earendil-works/pi-coding-agent": "^1.0.3",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
