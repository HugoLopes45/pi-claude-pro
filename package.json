{
  "name": "pi-claude-pro",
  "version": "1.1.2",
  "description": "Use your Claude Pro, Max or Ultra plan in the Pi coding agent with Opus, Sonnet, Haiku and Fable. No API key, no Claude Code. Shows your usage limits and warns when requests are billed as extra usage.",
  "type": "module",
  "license": "MIT",
  "author": "HugoLopes45 (https://github.com/HugoLopes45)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HugoLopes45/pi-claude-pro.git"
  },
  "homepage": "https://github.com/HugoLopes45/pi-claude-pro#readme",
  "bugs": {
    "url": "https://github.com/HugoLopes45/pi-claude-pro/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "claude",
    "claude-pro",
    "claude-max",
    "claude-ultra",
    "claude-fable",
    "claude-subscription",
    "claude-code",
    "claude-oauth",
    "claude-opus",
    "claude-sonnet",
    "extra-usage",
    "pi-coding-agent",
    "subscription",
    "anthropic",
    "oauth",
    "coding-agent",
    "usage-limits"
  ],
  "files": [
    "extensions",
    "src"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && npm run lint && vitest --run",
    "lint": "node scripts/lint.ts",
    "check:live": "node scripts/live-check.ts",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.3",
    "@earendil-works/pi-coding-agent": "^1.0.3",
    "@types/node": "^26.6.4",
    "eslint": "^10.14.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
